<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EJS Frontend</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family:
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          'Segoe UI',
          Roboto,
          Oxygen,
          Ubuntu,
          Cantarell,
          'Open Sans',
          'Helvetica Neue',
          sans-serif;
      }
      html,
      body {
        width: 100%;
        height: 100vh;
        background-color: #333;
        color: #fff;
      }

      h1,
      h2,
      p {
        font-size: 80px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 500;
        color: #fff;
      }
    </style>
  </head>
  <body>
    <%- include("header")%>
    <h1>Welcome to Homegape EJS</h1>
  </body>
</html>
