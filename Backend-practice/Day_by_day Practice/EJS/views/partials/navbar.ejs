<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: Verdana, Geneva, Tahoma, sans-serif;
      }

      html,
      body {
        width: 100%;
        height: 100%;
      }
      nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 10px;
      }

      nav ul {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 15px;
        list-style-type: none;
      }
    </style>
  </head>
  <body>
    <nav>
      <h1>Sheriyans</h1>
      <h2><%=user %></h2>
      <ul>
        <li>Home</li>
        <li>Services</li>
        <li>About</li>
        <li>Contact Us</li>
      </ul>
    </nav>
  </body>
</html>
